# Copy to .env.local. Every one of these is optional — the app runs with none of them.

# Railway Postgres. In Railway this is set to ${{Postgres.DATABASE_URL}} and resolves on the
# private network. For local development use the public URL from the Railway dashboard
# (Postgres service → Variables → DATABASE_PUBLIC_URL). Without it the app still runs — the
# board is empty and nothing syncs, everything else works.
DATABASE_URL=

# ── the pet's judgement ───────────────────────────────────────────────
# Set ONE of these to put a model in the decision path. With neither, every Stockling falls
# back to its fixed-rule personality — which still runs, and is the baseline the model is
# measured against. Sensing (news, SEC filings) needs no key and happens either way.
#
# Anthropic takes precedence if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Anything OpenAI-compatible works through OPENAI_API_KEY. For Bitget's hackathon Qwen
# credits:  OPENAI_BASE_URL=https://hackathon.bitgetops.com/v1  and KIBBLE_MODEL=qwen3.8-max
OPENAI_BASE_URL=
# Defaults: claude-opus-5 for Anthropic, gpt-4o-mini for OpenAI-compatible.
KIBBLE_MODEL=

# Optional. When set, POST /api/tick with an x-tick-secret header runs one hourly tick on demand.
# The Railway cron service does not need it.
TICK_SECRET=

# ── execution on Bitget's demo exchange ───────────────────────────────
# Optional. With these set, the first pet adopted on each contract Bitget's demo environment lists
# (NVDA, TSLA, AAPL, SPCX) sends its trades there as market orders. Every request carries
# `paptrading: 1`, so only demo funds can move. The key must be created from inside Demo mode
# (Bitget → switch to Demo → API Key Management); a live key answers 40099.
BITGET_DEMO_KEY=
BITGET_DEMO_SECRET=
BITGET_DEMO_PASSPHRASE=
